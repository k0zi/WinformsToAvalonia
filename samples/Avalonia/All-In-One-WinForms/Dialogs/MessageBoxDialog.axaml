<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="All_In_One_WinForms.Dialogs.MessageBoxDialog"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Title="Message">
    <StackPanel Margin="16" Spacing="16">
        <TextBlock x:Name="messageText" TextWrapping="Wrap" />
        <StackPanel x:Name="buttonsPanel" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" />
    </StackPanel>
</Window>
