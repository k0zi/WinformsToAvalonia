<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="using:All_In_One_WinForms.Dialogs"
        x:Class="All_In_One_WinForms.Dialogs.ColorPickerDialog"
        Width="280" Height="380" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Title="Color">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" MinWidth="80" IsDefault="True" Click="OkButton_Click" />
            <Button Content="Cancel" MinWidth="80" IsCancel="True" Click="CancelButton_Click" />
        </StackPanel>
        <ListBox x:Name="colorList">
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="dialogs:ColorChoice">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="20" Height="20" BorderThickness="1" BorderBrush="Gray"
                                Background="{Binding Swatch}" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
