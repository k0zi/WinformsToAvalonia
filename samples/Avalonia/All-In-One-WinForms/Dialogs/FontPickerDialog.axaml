<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="All_In_One_WinForms.Dialogs.FontPickerDialog"
        Width="320" Height="420" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Title="Font">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" MinWidth="80" IsDefault="True" Click="OkButton_Click" />
            <Button Content="Cancel" MinWidth="80" IsCancel="True" Click="CancelButton_Click" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <TextBlock Text="Size:" VerticalAlignment="Center" />
            <NumericUpDown x:Name="sizeUpDown" Width="120" Minimum="6" Maximum="72" Increment="1" />
        </StackPanel>
        <ListBox x:Name="familyList" />
    </DockPanel>
</Window>
