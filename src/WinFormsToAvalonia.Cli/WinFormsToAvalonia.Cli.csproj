<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\WinFormsToAvalonia.Core\WinFormsToAvalonia.Core.csproj" />
    <ProjectReference Include="..\WinFormsToAvalonia.FallbackControls\WinFormsToAvalonia.FallbackControls.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>wf2a</ToolCommandName>
    <PackageId>WinFormsToAvalonia</PackageId>
    <!-- Local packs get this; a release overrides it from the git tag (-p:Version=, see
         .github/workflows/build.yml). -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <!-- The repo root's artifacts/, not this project's - which is where the README's
         "install from your own checkout" command looks. -->
    <PackageOutputPath>$(MSBuildThisFileDirectory)..\..\artifacts\</PackageOutputPath>
    <Authors>David Kozma</Authors>
    <Description>Reads a WinForms .csproj with Roslyn and generates a new Avalonia MVVM application - one Window View + ViewModel per Form, one UserControl View + ViewModel per UserControl. The source project is read-only input; nothing is converted in place.</Description>
    <PackageTags>winforms;avalonia;migration;converter;roslyn;mvvm;dotnet-tool</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/k0zi/WinformsToAvalonia</PackageProjectUrl>
    <RepositoryUrl>https://github.com/k0zi/WinformsToAvalonia.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright (c) 2025 David Kozma</Copyright>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>https://github.com/k0zi/WinformsToAvalonia/releases</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <!-- Packed into the package root, which is where nuget.org looks for it. -->
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
