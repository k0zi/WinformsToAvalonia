<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WarehouseAvaloniaApp.ViewModels"
        x:Class="WarehouseAvaloniaApp.Views.StockOverviewForm"
        x:DataType="vm:StockOverviewFormViewModel"

        Width="900"
        Height="560"
        Title="Stock Overview — WarehouseApp"
        WindowStartupLocation="CenterOwner"        >
    <Design.DataContext>
        <vm:StockOverviewFormViewModel/>
    </Design.DataContext>

    <Canvas>
        <Grid Name="mainSplitContainer" />
        <StackPanel Name="mainToolStrip"
        DockPanel.Dock="Top" />
        <StackPanel Name="statusStrip" />
    </Canvas>
</Window>
