<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WarehouseAvaloniaApp.ViewModels"
        x:Class="WarehouseAvaloniaApp.Views.UsersForm"
        x:DataType="vm:UsersFormViewModel"

        Width="820"
        Height="520"
        Title="Users &amp; Roles — WarehouseApp"
        WindowStartupLocation="CenterOwner"        >
    <Design.DataContext>
        <vm:UsersFormViewModel/>
    </Design.DataContext>

    <Canvas>
        <Grid Name="mainSplitContainer" />
        <StackPanel Name="mainToolStrip"
        DockPanel.Dock="Top" />
        <StackPanel Name="statusStrip" />
    </Canvas>
</Window>
