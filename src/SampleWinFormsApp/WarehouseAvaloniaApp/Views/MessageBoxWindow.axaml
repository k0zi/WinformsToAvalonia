<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="WarehouseAvaloniaApp.Views.MessageBoxWindow"
        Width="400" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20" Spacing="20">
        <TextBlock Name="MessageText" TextWrapping="Wrap"/>
        <StackPanel Name="ButtonPanel" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"/>
    </StackPanel>
</Window>
