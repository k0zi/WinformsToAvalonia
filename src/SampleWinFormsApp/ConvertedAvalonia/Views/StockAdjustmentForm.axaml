<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ConvertedAvalonia.ViewModels"
        x:Class="ConvertedAvalonia.Views.StockAdjustmentForm"
        x:DataType="vm:StockAdjustmentFormViewModel"

        Width="760"
        Height="500"
        Title="Stock Adjustment — Physical Count — WarehouseApp"
        WindowStartupLocation="CenterOwner"        >
    <Design.DataContext>
        <vm:StockAdjustmentFormViewModel/>
    </Design.DataContext>

    <DockPanel>
        <Grid Name="mainSplitContainer" />
    </DockPanel>
</Window>
