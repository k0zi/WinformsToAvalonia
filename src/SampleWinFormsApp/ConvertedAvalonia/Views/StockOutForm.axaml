<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ConvertedAvalonia.ViewModels"
        x:Class="ConvertedAvalonia.Views.StockOutForm"
        x:DataType="vm:StockOutFormViewModel"

        Title="&quot;Stock Out — Goods Issue — WarehouseApp&quot;"        >
    <Design.DataContext>
        <vm:StockOutFormViewModel/>
    </Design.DataContext>

    <DockPanel>
        <DataGrid Name="linesGrid"
        AutoGenerateColumns="false"
        IsReadOnly="true" />
        <Panel Name="actionPanel"
        DockPanel.Dock="Bottom"
        Height="52">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Name="removeLineButton"
                Grid.Row="0"
                Grid.Column="0"
                Content="&quot;Remove Line&quot;"
                Width="110"
                Height="28" />
                <Button Name="postButton"
                Grid.Row="0"
                Grid.Column="2"
                Content="&quot;Post Issue&quot;"
                Width="120"
                Height="32"
                FontFamily="Segoe UI"
                FontSize="9" />
                <TextBlock Name="statusLabel"
                Grid.Row="1"
                Grid.Column="1"
                Foreground="SeaGreen" />
            </Grid>
        </Panel>
        <Panel Name="entryPanel"
        DockPanel.Dock="Top"
        Height="90">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Name="warehouseLabel"
                Grid.Row="0"
                Grid.Column="0"
                Text="&quot;Warehouse:&quot;" />
                <ComboBox Name="warehouseComboBox"
                Grid.Row="0"
                Grid.Column="1"
                Width="180" />
                <TextBlock Name="productLabel"
                Grid.Row="0"
                Grid.Column="3"
                Text="&quot;Product:&quot;" />
                <ComboBox Name="productComboBox"
                Grid.Row="0"
                Grid.Column="4"
                Width="220" />
                <TextBlock Name="quantityLabel"
                Grid.Row="2"
                Grid.Column="0"
                Text="&quot;Quantity:&quot;" />
                <!-- TODO: Unmapped control: NumericStepperControl (quantityStepper) -->
                <Button Name="addLineButton"
                Grid.Row="1"
                Grid.Column="2"
                Content="&quot;Add Line&quot;"
                Width="100"
                Height="28" />
            </Grid>
        </Panel>
    </DockPanel>
</Window>
