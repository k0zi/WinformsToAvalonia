<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ConvertedAvalonia.ViewModels"
        x:Class="ConvertedAvalonia.Views.UsersForm"
        x:DataType="vm:UsersFormViewModel"

        Title="&quot;Users &amp; Roles — WarehouseApp&quot;"        >
    <Design.DataContext>
        <vm:UsersFormViewModel/>
    </Design.DataContext>

    <Canvas>
        <Grid Name="mainSplitContainer" />
        <ToolBar Name="mainToolStrip"
        DockPanel.Dock="Top" />
        <StatusBar Name="statusStrip" />
    </Canvas>
</Window>
