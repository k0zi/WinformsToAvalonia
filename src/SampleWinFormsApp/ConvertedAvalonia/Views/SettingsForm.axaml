<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ConvertedAvalonia.ViewModels"
        x:Class="ConvertedAvalonia.Views.SettingsForm"
        x:DataType="vm:SettingsFormViewModel"

        Width="460"
        Height="460"
        Title="Settings — WarehouseApp"
        WindowStartupLocation="CenterOwner"        >
    <Design.DataContext>
        <vm:SettingsFormViewModel/>
    </Design.DataContext>

    <DockPanel>
        <TabControl Name="mainTabControl" />
    </DockPanel>
</Window>
