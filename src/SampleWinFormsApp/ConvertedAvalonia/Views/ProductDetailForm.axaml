<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ConvertedAvalonia.ViewModels"
        x:Class="ConvertedAvalonia.Views.ProductDetailForm"
        x:DataType="vm:ProductDetailFormViewModel"

        Width="600"
        Height="380"
        Title="Product Detail — WarehouseApp"        >
    <Design.DataContext>
        <vm:ProductDetailFormViewModel/>
    </Design.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Name="detailsGroupBox"
        Grid.Row="0"
        Grid.Column="0"
        Width="430"
        Height="330">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Name="fieldsTableLayoutPanel"
                Grid.Row="0"
                Grid.Column="0"
                Width="400"
                Height="290">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Name="skuLabel"
                        Text="SKU:"
                        TextAlignment="Left"
                        VerticalAlignment="Center"
                        Grid.Column="0"
                        Grid.Row="0" />
                        <TextBox Name="skuTextBox"
                        Margin="3,5,3,5"
                        Grid.Column="1"
                        Grid.Row="0"
                        Text="{Binding Sku}" />
                        <TextBlock Name="nameLabel"
                        Text="Name:"
                        TextAlignment="Left"
                        VerticalAlignment="Center"
                        Grid.Column="0"
                        Grid.Row="1" />
                        <TextBox Name="nameTextBox"
                        Margin="3,5,3,5"
                        Grid.Column="1"
                        Grid.Row="1"
                        Text="{Binding Name}" />
                        <TextBlock Name="descriptionLabel"
                        Text="Description:"
                        TextAlignment="Left"
                        VerticalAlignment="Center"
                        Grid.Column="0"
                        Grid.Row="2" />
                        <TextBox Name="descriptionTextBox"
                        Margin="3,5,3,5"
                        Grid.Column="1"
                        Grid.Row="2"
                        Text="{Binding Description}" />
                        <TextBlock Name="categoryLabel"
                        Text="Category:"
                        TextAlignment="Left"
                        VerticalAlignment="Center"
                        Grid.Column="0"
                        Grid.Row="3" />
                        <ComboBox Name="categoryComboBox"
                        Margin="3,5,3,5"
                        Grid.Column="1"
                        Grid.Row="3" />
                        <TextBlock Name="supplierLabel"
                        Text="Supplier:"
                        TextAlignment="Left"
                        VerticalAlignment="Center"
                        Grid.Column="0"
                        Grid.Row="4" />
                        <ComboBox Name="supplierComboBox"
                        Margin="3,5,3,5"
                        Grid.Column="1"
                        Grid.Row="4" />
                        <TextBlock Name="unitOfMeasureLabel"
                        Text="Unit:"
                        TextAlignment="Left"
                        VerticalAlignment="Center"
                        Grid.Column="0"
                        Grid.Row="5" />
                        <ComboBox Name="unitOfMeasureDomainUpDown"
                        Margin="3,5,3,5"
                        SelectedIndex="0"
                        Grid.Column="1"
                        Grid.Row="5" />
                        <TextBlock Name="unitPriceLabel"
                        Text="Unit Price ($):"
                        TextAlignment="Left"
                        VerticalAlignment="Center"
                        Grid.Column="0"
                        Grid.Row="6" />
                        <NumericUpDown Name="unitPriceNumericUpDown"
                        Margin="3,5,3,5"
                        Minimum="0"
                        Maximum="100000"
                        Grid.Column="1"
                        Grid.Row="6"
                        Value="{Binding UnitPrice}" />
                        <TextBlock Name="reorderLevelLabel"
                        Text="Reorder Level:"
                        TextAlignment="Left"
                        VerticalAlignment="Center"
                        Grid.Column="0"
                        Grid.Row="7" />
                        <NumericUpDown Name="reorderLevelNumericUpDown"
                        Margin="3,5,3,5"
                        Minimum="0"
                        Maximum="10000"
                        Grid.Column="1"
                        Grid.Row="7"
                        Value="{Binding ReorderLevel}" />
                    </Grid>
                </Grid>
                <CheckBox Name="isActiveCheckBox"
                Grid.Row="1"
                Grid.Column="0"
                Content="Active"
                IsChecked="true" />
            </Grid>
        </Border>
        <Image Name="productPictureBox"
        Grid.Row="0"
        Grid.Column="1"
        Width="120"
        Height="120"
        BorderThickness="1" />
        <Button Name="chooseImageButton"
        Grid.Row="1"
        Grid.Column="1"
        Content="Choose Image..."
        Width="120"
        Height="28" />
    </Grid>
</Window>
