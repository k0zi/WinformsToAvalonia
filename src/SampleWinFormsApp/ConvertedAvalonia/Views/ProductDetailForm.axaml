<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ConvertedAvalonia.ViewModels"
        x:Class="ConvertedAvalonia.Views.ProductDetailForm"
        x:DataType="vm:ProductDetailFormViewModel"

        Title="&quot;Product Detail — WarehouseApp&quot;"        >
    <Design.DataContext>
        <vm:ProductDetailFormViewModel/>
    </Design.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Name="detailsGroupBox"
        Grid.Row="0"
        Grid.Column="0"
        Width="430"
        Height="330">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Name="fieldsTableLayoutPanel"
                Grid.Row="0"
                Grid.Column="0"
                Width="400"
                Height="290">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Name="skuLabel"
                        Text="&quot;SKU:&quot;"
                        Grid.Column="0"
                        Grid.Row="0" />
                        <TextBox Name="skuTextBox"
                        Margin="3,5,3,5"
                        Grid.Column="1"
                        Grid.Row="0" />
                        <TextBlock Name="nameLabel"
                        Text="&quot;Name:&quot;"
                        Grid.Column="0"
                        Grid.Row="1" />
                        <TextBox Name="nameTextBox"
                        Margin="3,5,3,5"
                        Grid.Column="1"
                        Grid.Row="1" />
                        <TextBlock Name="descriptionLabel"
                        Text="&quot;Description:&quot;"
                        Grid.Column="0"
                        Grid.Row="2" />
                        <TextBox Name="descriptionTextBox"
                        Margin="3,5,3,5"
                        Grid.Column="1"
                        Grid.Row="2" />
                        <TextBlock Name="categoryLabel"
                        Text="&quot;Category:&quot;"
                        Grid.Column="0"
                        Grid.Row="3" />
                        <ComboBox Name="categoryComboBox"
                        Margin="3,5,3,5"
                        Grid.Column="1"
                        Grid.Row="3" />
                        <TextBlock Name="supplierLabel"
                        Text="&quot;Supplier:&quot;"
                        Grid.Column="0"
                        Grid.Row="4" />
                        <ComboBox Name="supplierComboBox"
                        Margin="3,5,3,5"
                        Grid.Column="1"
                        Grid.Row="4" />
                        <TextBlock Name="unitOfMeasureLabel"
                        Text="&quot;Unit:&quot;"
                        Grid.Column="0"
                        Grid.Row="5" />
                        <ComboBox Name="unitOfMeasureDomainUpDown"
                        Margin="3,5,3,5"
                        SelectedIndex="0"
                        Grid.Column="1"
                        Grid.Row="5" />
                        <TextBlock Name="unitPriceLabel"
                        Text="&quot;Unit Price ($):&quot;"
                        Grid.Column="0"
                        Grid.Row="6" />
                        <NumericUpDown Name="unitPriceNumericUpDown"
                        Margin="3,5,3,5"
                        Minimum="0"
                        Maximum="100000"
                        Grid.Column="1"
                        Grid.Row="6" />
                        <TextBlock Name="reorderLevelLabel"
                        Text="&quot;Reorder Level:&quot;"
                        Grid.Column="0"
                        Grid.Row="7" />
                        <NumericUpDown Name="reorderLevelNumericUpDown"
                        Margin="3,5,3,5"
                        Minimum="0"
                        Maximum="10000"
                        Grid.Column="1"
                        Grid.Row="7" />
                    </Grid>
                </Grid>
                <CheckBox Name="isActiveCheckBox"
                Grid.Row="1"
                Grid.Column="0"
                Content="&quot;Active&quot;"
                IsChecked="true" />
            </Grid>
        </Border>
        <Image Name="productPictureBox"
        Grid.Row="0"
        Grid.Column="1"
        Width="120"
        Height="120" />
        <Button Name="chooseImageButton"
        Grid.Row="1"
        Grid.Column="1"
        Content="&quot;Choose Image...&quot;"
        Width="120"
        Height="28" />
    </Grid>
</Window>
