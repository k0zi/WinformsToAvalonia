<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ConvertedAvalonia.ViewModels"
        x:Class="ConvertedAvalonia.Views.SuppliersForm"
        x:DataType="vm:SuppliersFormViewModel"

        Width="820"
        Height="520"
        Title="Suppliers — WarehouseApp"
        WindowStartupLocation="CenterOwner"        >
    <Design.DataContext>
        <vm:SuppliersFormViewModel/>
    </Design.DataContext>

    <Canvas>
        <Grid Name="mainSplitContainer" />
        <StackPanel Name="mainToolStrip"
        DockPanel.Dock="Top" />
        <StackPanel Name="statusStrip" />
    </Canvas>
</Window>
