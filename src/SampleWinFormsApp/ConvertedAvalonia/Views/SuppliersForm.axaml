<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ConvertedAvalonia.ViewModels"
        x:Class="ConvertedAvalonia.Views.SuppliersForm"
        x:DataType="vm:SuppliersFormViewModel"

        Title="&quot;Suppliers — WarehouseApp&quot;"        >
    <Design.DataContext>
        <vm:SuppliersFormViewModel/>
    </Design.DataContext>

    <Canvas>
        <Grid Name="mainSplitContainer" />
        <ToolBar Name="mainToolStrip"
        DockPanel.Dock="Top" />
        <StatusBar Name="statusStrip" />
    </Canvas>
</Window>
