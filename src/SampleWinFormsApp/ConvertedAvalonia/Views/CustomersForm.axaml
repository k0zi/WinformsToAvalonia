<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ConvertedAvalonia.ViewModels"
        x:Class="ConvertedAvalonia.Views.CustomersForm"
        x:DataType="vm:CustomersFormViewModel"

        Width="860"
        Height="540"
        Title="Customers — WarehouseApp"
        WindowStartupLocation="CenterOwner"        >
    <Design.DataContext>
        <vm:CustomersFormViewModel/>
    </Design.DataContext>

    <Canvas>
        <Grid Name="mainSplitContainer" />
        <StackPanel Name="mainToolStrip"
        DockPanel.Dock="Top" />
        <StackPanel Name="statusStrip" />
    </Canvas>
</Window>
