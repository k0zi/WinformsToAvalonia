<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ConvertedAvalonia.ViewModels"
        x:Class="ConvertedAvalonia.Views.ReportsForm"
        x:DataType="vm:ReportsFormViewModel"

        Width="780"
        Height="520"
        Title="Reports — WarehouseApp"
        WindowStartupLocation="CenterOwner"        >
    <Design.DataContext>
        <vm:ReportsFormViewModel/>
    </Design.DataContext>

    <DockPanel>
        <TabControl Name="mainTabControl" />
    </DockPanel>
</Window>
