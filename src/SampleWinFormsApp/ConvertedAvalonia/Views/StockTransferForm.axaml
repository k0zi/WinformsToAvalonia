<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ConvertedAvalonia.ViewModels"
        x:Class="ConvertedAvalonia.Views.StockTransferForm"
        x:DataType="vm:StockTransferFormViewModel"

        Title="&quot;Stock Transfer — WarehouseApp&quot;"        >
    <Design.DataContext>
        <vm:StockTransferFormViewModel/>
    </Design.DataContext>

    <DockPanel>
        <DataGrid Name="linesGrid"
        AutoGenerateColumns="false"
        IsReadOnly="true" />
        <Panel Name="actionPanel"
        DockPanel.Dock="Bottom"
        Height="52">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Name="removeLineButton"
                Text="&quot;Remove Line&quot;"
                Canvas.Left="12"
                Canvas.Top="10" />
                <Button Name="postButton"
                Text="&quot;Post Transfer&quot;"
                Canvas.Left="600"
                Canvas.Top="10"
                FontFamily="Segoe UI"
                FontSize="9" />
                <TextBlock Name="statusLabel"
                Canvas.Left="140"
                Canvas.Top="16"
                Foreground="SeaGreen" />
            </Grid>
        </Panel>
        <Panel Name="entryPanel"
        DockPanel.Dock="Top"
        Height="90">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Name="fromLabel"
                Text="&quot;From:&quot;"
                Canvas.Left="12"
                Canvas.Top="15" />
                <ComboBox Name="fromWarehouseComboBox"
                Canvas.Left="60"
                Canvas.Top="12"
                Width="170" />
                <Button Name="swapButton"
                Text="&quot;⇄&quot;"
                Canvas.Left="238"
                Canvas.Top="11" />
                <TextBlock Name="toLabel"
                Text="&quot;To:&quot;"
                Canvas.Left="278"
                Canvas.Top="15" />
                <ComboBox Name="toWarehouseComboBox"
                Canvas.Left="310"
                Canvas.Top="12"
                Width="170" />
                <TextBlock Name="productLabel"
                Text="&quot;Product:&quot;"
                Canvas.Left="12"
                Canvas.Top="50" />
                <ComboBox Name="productComboBox"
                Canvas.Left="80"
                Canvas.Top="46"
                Width="250" />
                <TextBlock Name="quantityLabel"
                Text="&quot;Quantity:&quot;"
                Canvas.Left="345"
                Canvas.Top="50" />
                <NumericUpDown Name="quantityNumericUpDown"
                Canvas.Left="410"
                Canvas.Top="46"
                Width="70"
                Minimum="1"
                Maximum="10000"
                Value="1" />
                <Button Name="addLineButton"
                Text="&quot;Add Line&quot;"
                Canvas.Left="495"
                Canvas.Top="44" />
            </Grid>
        </Panel>
    </DockPanel>
</Window>
