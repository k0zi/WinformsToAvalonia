<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ConvertedAvalonia.ViewModels"
        x:Class="ConvertedAvalonia.Views.DashboardForm"
        x:DataType="vm:DashboardFormViewModel"

        Title="&quot;Dashboard — WarehouseApp&quot;"        >
    <Design.DataContext>
        <vm:DashboardFormViewModel/>
    </Design.DataContext>

    <DockPanel>
        <WrapPanel Name="tilesFlowPanel"
        Background="#F5F7FA">
            <Canvas>
                <!-- TODO: Unmapped control: CardTileControl (productsTile) -->
                <!-- TODO: Unmapped control: CardTileControl (productDetailTile) -->
                <!-- TODO: Unmapped control: CardTileControl (categoriesTile) -->
                <!-- TODO: Unmapped control: CardTileControl (suppliersTile) -->
                <!-- TODO: Unmapped control: CardTileControl (customersTile) -->
                <!-- TODO: Unmapped control: CardTileControl (warehousesTile) -->
                <!-- TODO: Unmapped control: CardTileControl (stockOverviewTile) -->
                <!-- TODO: Unmapped control: CardTileControl (stockInTile) -->
                <!-- TODO: Unmapped control: CardTileControl (stockOutTile) -->
                <!-- TODO: Unmapped control: CardTileControl (stockTransferTile) -->
                <!-- TODO: Unmapped control: CardTileControl (stockAdjustmentTile) -->
                <!-- TODO: Unmapped control: CardTileControl (purchaseOrdersTile) -->
                <!-- TODO: Unmapped control: CardTileControl (purchaseOrderDetailTile) -->
                <!-- TODO: Unmapped control: CardTileControl (salesOrdersTile) -->
                <!-- TODO: Unmapped control: CardTileControl (salesOrderDetailTile) -->
                <!-- TODO: Unmapped control: CardTileControl (usersTile) -->
                <!-- TODO: Unmapped control: CardTileControl (reportsTile) -->
                <!-- TODO: Unmapped control: CardTileControl (settingsTile) -->
            </Canvas>
        </WrapPanel>
        <Panel Name="sidePanel"
        DockPanel.Dock="Right"
        Width="200">
            <DockPanel>
                <!-- TODO: Unmapped control: GaugeControl (capacityGauge) -->
                <TextBlock Name="capacityLabel"
                Text="&quot;Overall Capacity&quot;"
                DockPanel.Dock="Top"
                FontFamily="Segoe UI"
                FontSize="9" />
            </DockPanel>
        </Panel>
        <StackPanel Name="mainToolStrip"
        DockPanel.Dock="Top" />
        <Menu Name="menuStrip"
        DockPanel.Dock="Top" />
        <StackPanel Name="statusStrip" />
    </DockPanel>
</Window>
