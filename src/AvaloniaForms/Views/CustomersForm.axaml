<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaForms.ViewModels"
        x:Class="AvaloniaForms.Views.CustomersForm"
        x:DataType="vm:CustomersFormViewModel"

        Title="&quot;Customers — WarehouseApp&quot;"        >
    <Design.DataContext>
        <vm:CustomersFormViewModel/>
    </Design.DataContext>

    <Canvas>
        <Grid Name="mainSplitContainer" />
        <ToolBar Name="mainToolStrip"
        DockPanel.Dock="Top" />
        <StatusBar Name="statusStrip" />
    </Canvas>
</Window>
