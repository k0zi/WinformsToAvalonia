<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaForms.ViewModels"
        x:Class="AvaloniaForms.Views.PurchaseOrderDetailForm"
        x:DataType="vm:PurchaseOrderDetailFormViewModel"

        Title="&quot;Purchase Order Detail — WarehouseApp&quot;"        >
    <Design.DataContext>
        <vm:PurchaseOrderDetailFormViewModel/>
    </Design.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid Name="headerTableLayoutPanel"
        Canvas.Left="12"
        Canvas.Top="12">
            <Grid>
                <TextBlock Name="orderNumberLabel"
                Text="&quot;Order #:&quot;" />
                <TextBlock Name="orderNumberValueLabel"
                Text="&quot;(new)&quot;"
                FontFamily="Segoe UI"
                FontSize="9" />
                <TextBlock Name="supplierLabel"
                Text="&quot;Supplier:&quot;" />
                <ComboBox Name="supplierComboBox"
                Margin="new System.Windows.Forms.Padding(3, 3, 3, 3)" />
                <TextBlock Name="orderDateLabel"
                Text="&quot;Order Date:&quot;" />
                <DatePicker Name="orderDatePicker"
                Margin="new System.Windows.Forms.Padding(3, 3, 3, 3)" />
                <TextBlock Name="expectedDateLabel"
                Text="&quot;Expected:&quot;" />
                <DatePicker Name="expectedDatePicker"
                Margin="new System.Windows.Forms.Padding(3, 3, 3, 3)" />
                <TextBlock Name="statusLabel"
                Text="&quot;Status:&quot;" />
                <ComboBox Name="statusComboBox"
                Margin="new System.Windows.Forms.Padding(3, 3, 3, 3)" />
                <TextBlock Name="notesLabel"
                Text="&quot;Notes:&quot;" />
                <TextBox Name="notesTextBox"
                Margin="new System.Windows.Forms.Padding(3, 3, 3, 3)"
                AcceptsReturn="true"
                Height="40" />
            </Grid>
        </Grid>
        <!-- TODO: Unmapped control: StatusBadgeControl (statusBadge) -->
        <Panel Name="lineEntryPanel"
        Canvas.Left="0"
        Canvas.Top="205">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Name="productLabel"
                Text="&quot;Product:&quot;"
                Canvas.Left="12"
                Canvas.Top="215" />
                <!-- TODO: Unmapped control: AutocompleteSearchBox (productSearchBox) -->
                <TextBlock Name="qtyLabel"
                Text="&quot;Qty:&quot;"
                Canvas.Left="272"
                Canvas.Top="215" />
                <NumericUpDown Name="qtyNumericUpDown"
                Canvas.Left="272"
                Canvas.Top="232"
                Width="70"
                Minimum="1"
                Maximum="10000"
                Value="1" />
                <TextBlock Name="priceLabel"
                Text="&quot;Unit Price:&quot;"
                Canvas.Left="352"
                Canvas.Top="215" />
                <NumericUpDown Name="unitPriceNumericUpDown"
                Canvas.Left="352"
                Canvas.Top="232"
                Width="90"
                Minimum="0"
                Maximum="100000" />
                <Button Name="addLineButton"
                Text="&quot;Add Line&quot;"
                Canvas.Left="452"
                Canvas.Top="230" />
            </Grid>
        </Panel>
        <DataGrid Name="linesGrid"
        Canvas.Left="12"
        Canvas.Top="275"
        AutoGenerateColumns="false"
        IsReadOnly="true" />
        <Button Name="printButton"
        Text="&quot;Print...&quot;"
        Canvas.Left="12"
        Canvas.Top="485" />
    </Grid>
</Window>
