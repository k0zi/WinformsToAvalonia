<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaForms.ViewModels"
        x:Class="AvaloniaForms.Views.StockOverviewForm"
        x:DataType="vm:StockOverviewFormViewModel"

        Title="&quot;Stock Overview — WarehouseApp&quot;"        >
    <Design.DataContext>
        <vm:StockOverviewFormViewModel/>
    </Design.DataContext>

    <Canvas>
        <Grid Name="mainSplitContainer" />
        <ToolBar Name="mainToolStrip"
        DockPanel.Dock="Top" />
        <StatusBar Name="statusStrip" />
    </Canvas>
</Window>
