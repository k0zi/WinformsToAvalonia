<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaForms.ViewModels"
        x:Class="AvaloniaForms.Views.WarehousesForm"
        x:DataType="vm:WarehousesFormViewModel"

        Title="&quot;Warehouses &amp; Locations — WarehouseApp&quot;"        >
    <Design.DataContext>
        <vm:WarehousesFormViewModel/>
    </Design.DataContext>

    <DockPanel>
        <Panel Name="treeViewPanel"
        DockPanel.Dock="Left"
        Width="300">
            <DockPanel>
                <TreeView Name="locationsTreeView" />
            </DockPanel>
        </Panel>
        <GridSplitter Name="splitter"
        DockPanel.Dock="Left"
        Width="4" />
        <Panel Name="detailFillPanel">
            <DockPanel>
                <ListBox Name="shelfContentsListView" />
                <Panel Name="gaugePanel"
                DockPanel.Dock="Top"
                Height="170"
                Padding="new System.Windows.Forms.Padding(12)">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Name="selectedNameLabel"
                        Text="&quot;Select a warehouse or location&quot;"
                        FontFamily="Segoe UI"
                        FontSize="11"
                        Canvas.Left="12"
                        Canvas.Top="8" />
                        <!-- TODO: Unmapped control: GaugeControl (capacityGauge) -->
                        <TextBlock Name="capacityDetailLabel"
                        Canvas.Left="180"
                        Canvas.Top="60"
                        Foreground="Gray" />
                    </Grid>
                </Panel>
            </DockPanel>
        </Panel>
        <ToolBar Name="mainToolStrip"
        DockPanel.Dock="Top" />
        <StatusBar Name="statusStrip" />
    </DockPanel>
</Window>
