<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- The one place in this repo that sees Avalonia. The converter itself never references it -
         it emits text - which is exactly why its mapping tables cannot be checked by compiling
         them. These are *reference* assemblies read as metadata, never loaded for execution.
         The versions must match AvaloniaProjectScaffolder's, or this suite would be checking a
         different Avalonia than the generated projects use; AvaloniaVersionTests asserts that. -->
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.1" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.0" />

    <!-- The other side of the same question: what WinForms declares. Read as metadata only, and
         pinned by version like the Avalonia references above rather than found by groping around
         the NuGet cache at run time. GeneratePathProperty is what lets the copy below name it. -->
    <PackageReference Include="Microsoft.WindowsDesktop.App.Ref" Version="10.0.11"
                      GeneratePathProperty="true" ExcludeAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(PkgMicrosoft_WindowsDesktop_App_Ref)/ref/net10.0/System.Windows.Forms.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WinFormsToAvalonia.Core\WinFormsToAvalonia.Core.csproj" />
  </ItemGroup>

</Project>
